# ------------------------------------------------------------------
# Copia este archivo a .env SOLO en local. En la nube, pon estas
# variables como secretos del proveedor (Render, Railway, Fly…).
# Nunca subas el .env al repositorio.
# ------------------------------------------------------------------

# --- General ---
PORT=8080
PUBLIC_URL=https://tu-servicio.onrender.com
DATA_DIR=./data
TIMEZONE=Europe/Madrid
# 1 = sin conexiones reales (Shopify y WhatsApp simulados). Para probar.
DEMO_MODE=0

# --- Panel (acceso del propietario) ---
PANEL_PASSWORD=pon-una-contraseña-larga
# Cadena aleatoria larga para firmar la sesión: openssl rand -hex 32
SESSION_SECRET=

# --- Shopify (app del Dev Dashboard, client credentials) ---
SHOPIFY_SHOP=palaazzo            # subdominio de tu *.myshopify.com, sin ".myshopify.com"
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=           # también se usa para validar el HMAC de los webhooks
SHOPIFY_API_VERSION=2026-10

# --- WhatsApp Business Platform (Cloud API). Vacío = modo semiautomático ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=             # para validar X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=           # cadena que inventas tú para verificar el webhook
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_CONSULTA=consulta_pedido_proveedor
WHATSAPP_TEMPLATE_LANG=es

# --- Claude (opcional: interpretar respuestas del proveedor) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Alertas al móvil (opcional, https://ntfy.sh) ---
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Finanzas (ajusta a tus tarifas reales) ---
PAYMENT_FEE_PERCENT=2.1
PAYMENT_FEE_FIXED=0.25

# --- Protección de datos ---
PII_RETENTION_DAYS=90
