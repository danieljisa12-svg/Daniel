{%- comment -%} Precio con tachado solo si el producto tiene precio de comparación (directiva Omnibus: debe ser el más bajo de los 30 días previos). {%- endcomment -%}
{%- liquid
  if variant
    assign p = variant.price
    assign c = variant.compare_at_price
    assign varies = false
  else
    assign p = product.price
    assign c = product.compare_at_price
    assign varies = product.price_varies
  endif
  assign on_sale = false
  if c > p
    assign on_sale = true
  endif
-%}
<div class="price{% if on_sale %} price--sale{% endif %}" data-price>
  <span class="price__now">{% if varies %}{{ 'products.from' | t }} {% endif %}{{ p | money }}</span>
  {%- if on_sale -%}<s><span class="visually-hidden">Precio anterior:</span> {{ c | money }}</s>{%- endif -%}
</div>
