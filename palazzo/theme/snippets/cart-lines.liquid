{%- if cart.item_count == 0 -%}
  <p class="empty">{{ 'cart.empty' | t }}</p>
{%- else -%}
  {%- for item in cart.items -%}
    <div class="line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}</a>
      <div>
        <a class="line__t" href="{{ item.url }}">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}<div class="line__v">{{ item.variant.title }}</div>{%- endunless -%}
        <div class="qty">
          <button type="button" data-qty-change="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Quitar una unidad de {{ item.product.title | escape }}">−</button>
          <input type="number" value="{{ item.quantity }}" min="0" readonly aria-label="{{ 'products.quantity' | t }}">
          <button type="button" data-qty-change="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Añadir una unidad de {{ item.product.title | escape }}">+</button>
        </div>
      </div>
      <div style="text-align:right">
        <div style="font-weight:700">{{ item.final_line_price | money }}</div>
        <button class="line__rm" type="button" data-qty-change="{{ item.key }}" data-qty="0">{{ 'cart.remove' | t }}</button>
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}
