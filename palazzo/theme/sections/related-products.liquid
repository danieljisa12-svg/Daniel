<section class="section section--tight" data-related data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related" {{ section.shopify_attributes }}>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
  <div class="wrap">
    <div class="section-head"><h2>{{ section.settings.heading | default: 'products.related' | t }}</h2></div>
    <div class="grid">
      {%- for p in recommendations.products -%}{%- render 'product-card', card: p, show_vendor: true -%}{%- endfor -%}
    </div>
  </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Productos relacionados",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "También te puede interesar" },
    { "type": "range", "id": "limit", "label": "Número de productos", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
