<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="news">
      <div>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div style="margin-top:14px">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <div>
        {%- form 'customer', id: 'Newsletter-' | append: section.id -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="notice" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}<p class="notice notice--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
            <div class="news__form">
              <label class="visually-hidden" for="NewsEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
              <input class="input" id="NewsEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.email' | t }}">
              <button class="btn" type="submit">{{ 'newsletter.submit' | t }}</button>
            </div>
            <label class="check">
              <input type="checkbox" required name="contact[accepts_marketing]" value="true">
              <span>{{ 'newsletter.consent' | t: shop: shop.name }}{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>.{% endif %}</span>
            </label>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Suscripción",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Novedades, sin ruido" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Un email cuando haya un producto nuevo o una oferta de verdad. Nada más.</p>", "info": "No prometas descuentos de bienvenida si no existen." }
  ],
  "presets": [{ "name": "Suscripción" }]
}
{% endschema %}
