<div class="wrap">
  <header class="page-head"><h1>{{ section.settings.heading }}</h1></header>
  <div class="collections">
    {%- for c in collections -%}
      {%- if c.handle != 'frontpage' and c.all_products_count > 0 -%}{%- render 'collection-card', c: c -%}{%- endif -%}
    {%- endfor -%}
  </div>
</div>
<div style="height:clamp(48px,7vw,96px)"></div>
{% schema %}
{ "name": "Lista de colecciones", "settings": [{ "type": "text", "id": "heading", "label": "Título", "default": "Colecciones" }] }
{% endschema %}
