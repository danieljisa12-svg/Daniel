<article class="wrap" style="max-width:820px">
  <header class="page-head">
    <p class="muted">{{ article.published_at | date: '%d/%m/%Y' }}</p>
    <h1>{{ article.title }}</h1>
  </header>
  {%- if article.image -%}<div style="border-radius:var(--r);overflow:hidden;margin-bottom:32px">{{ article.image | image_url: width: 1600 | image_tag: widths: '800,1200,1600', alt: article.title }}</div>{%- endif -%}
  <div class="rte page-body">{{ article.content }}</div>
</article>
{% schema %}
{ "name": "Artículo" }
{% endschema %}
