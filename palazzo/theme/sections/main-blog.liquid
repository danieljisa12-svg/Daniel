<div class="wrap">
  <header class="page-head"><h1>{{ blog.title }}</h1></header>
  {%- paginate blog.articles by 12 -%}
  <div class="collections">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}">
        <div class="card__media">{%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</div>
        <div class="card__body"><p class="card__vendor">{{ article.published_at | date: '%d/%m/%Y' }}</p><h3 class="card__title">{{ article.title }}</h3></div>
      </a>
    {%- else -%}<p class="empty">Aún no hay artículos.</p>{%- endfor -%}
  </div>
  {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>
<div style="height:clamp(48px,7vw,96px)"></div>
{% schema %}
{ "name": "Blog" }
{% endschema %}
