<section class="section" {{ section.shopify_attributes }}>
  <div class="wrap split{% if section.settings.reverse %} split--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 820px) 50vw, 100vw' }}
      {%- elsif section.settings.product -%}
        {{ section.settings.product.featured_media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', sizes: '(min-width: 820px) 50vw, 100vw', alt: section.settings.product.title }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="split__body">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}<h2 {{ block.shopify_attributes }} style="margin-bottom:20px">{{ block.settings.text }}</h2>
          {%- when 'quote' -%}<p class="quote" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
          {%- when 'text' -%}<div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}<a class="btn btn--ghost" href="{{ block.settings.link | default: section.settings.product.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Imagen con texto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "product", "id": "product", "label": "Producto (usa su foto si no hay imagen)" },
    { "type": "checkbox", "id": "reverse", "label": "Imagen a la derecha", "default": false }
  ],
  "blocks": [
    { "type": "heading", "name": "Titular", "settings": [{ "type": "text", "id": "text", "label": "Titular", "default": "Menos cosas. Mejor elegidas." }] },
    { "type": "quote", "name": "Frase destacada", "settings": [{ "type": "text", "id": "text", "label": "Frase" }] },
    { "type": "text", "name": "Texto", "settings": [{ "type": "richtext", "id": "text", "label": "Texto", "default": "<p>No queremos un catálogo infinito. Elegimos pocos productos, explicamos para qué sirven y qué incluyen, y te decimos el precio final antes de pagar.</p>" }] },
    { "type": "button", "name": "Botón", "settings": [
      { "type": "text", "id": "label", "label": "Texto", "default": "Ver producto" },
      { "type": "url", "id": "link", "label": "Enlace" }
    ] }
  ],
  "presets": [{ "name": "Imagen con texto", "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }] }]
}
{% endschema %}
