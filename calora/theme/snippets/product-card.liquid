{%- if card_product -%}
<a class="card" href="{{ card_product.url }}">
  {%- if card_product.featured_image -%}<img src="{{ card_product.featured_image | image_url: width: 600 }}" alt="{{ card_product.title | escape }}" width="600" height="600" loading="lazy">{%- endif -%}
  <span class="card-title">{{ card_product.title }}</span>
  <span class="card-price">{{ card_product.price | money }}{% if card_product.compare_at_price > card_product.price %} <s>{{ card_product.compare_at_price | money }}</s>{% endif %}</span>
</a>
{%- endif -%}
