<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if template.name == 'index' %}Calora® · Calentador de manos recargable 2 en 1{% else %}{{ page_title }} · Calora{% endif %}</title>
  {%- if template.name == 'index' -%}
    <meta name="description" content="Calora®: calentador de manos recargable y magnético 2 en 1. Calor en 3 segundos, 3 niveles hasta 55 °C, hasta 10 h de batería y carga USB-C. Envío gratis.">
  {%- elsif page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="theme-color" content="#120a06">
  <meta property="og:title" content="Calora® · Manos calientes en 3 segundos">
  <meta property="og:image" content="https:{{ 'c-hero.webp' | asset_url }}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%23ff5a14'/%3E%3Ctext x='32' y='45' font-family='Arial' font-weight='900' font-size='38' text-anchor='middle' fill='%23fff'%3EC%3C/text%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap">
  <link rel="preload" as="image" href="{{ 'c-hero.webp' | asset_url }}">
  {{ 'calora.css' | asset_url | stylesheet_tag }}
  <script>document.documentElement.classList.add("js");</script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  {%- comment -%} Oferta con fecha de fin real: cuando termina, la barra desaparece (no se reinicia). Cambia la fecha en data-deadline. {%- endcomment -%}
  {%- if settings.promo_text != blank -%}
  <div class="promo"{% if settings.promo_countdown %} data-promo data-deadline="{{ settings.promo_deadline }}"{% endif %}>
    <p><strong>{{ settings.promo_text }}</strong>{% if settings.promo_countdown %} <span class="promo-sep">·</span> Termina en <span class="promo-clock" data-clock>--:--:--</span>{% endif %}</p>
  </div>
  {%- endif -%}

  <header class="nav" data-nav>
    <a class="nav-logo" href="{{ routes.root_url }}" aria-label="Calora, inicio">CALORA<sup>®</sup></a>
    <nav class="nav-links" aria-label="Principal">
      <a href="{{ routes.root_url }}#como-funciona">Cómo funciona</a>
      <a href="{{ routes.root_url }}#comparativa">Por qué Calora</a>
      <a href="{{ routes.root_url }}#preguntas">Preguntas</a>
    </nav>
    <div class="nav-actions">
      <a class="btn btn-sm btn-fire nav-buy" href="{{ routes.root_url }}#comprar">Comprar</a>
      <button class="nav-cart" type="button" data-cart-open aria-label="Abrir la cesta">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="nav-cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </header>

  <main id="contenido">
    {{ content_for_layout }}
  </main>

  <footer class="footer">
    <div class="footer-top">
      <p class="footer-logo">CALORA<sup>®</sup></p>
      <p class="footer-claim">Calor de bolsillo, recargable y para compartir.</p>
    </div>
    <div class="footer-cols">
      <nav aria-label="Pie">
        <a href="{{ routes.root_url }}#como-funciona">Cómo funciona</a>
        <a href="{{ routes.root_url }}#comprar">Comprar</a>
        <a href="{{ routes.root_url }}#preguntas">Preguntas frecuentes</a>
        {%- for link in linklists.footer.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
      <nav aria-label="Legal">
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Política de devoluciones</a>{%- endif -%}
        {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">Política de envíos</a>{%- endif -%}
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacidad</a>{%- endif -%}
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Términos del servicio</a>{%- endif -%}
        {%- if shop.contact_page_url -%}<a href="{{ shop.contact_page_url }}">Contacto</a>{%- endif -%}
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <p class="pay-row" aria-label="Métodos de pago">
        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{%- endfor -%}
      </p>
    </div>
  </footer>

  <div class="cart-scrim" data-cart-scrim hidden></div>
  <aside class="cart" data-cart aria-label="Cesta" aria-hidden="true" tabindex="-1">
    <header class="cart-head">
      <h2>Tu cesta</h2>
      <button class="cart-close" type="button" data-cart-close aria-label="Cerrar la cesta">✕</button>
    </header>
    <p class="cart-ship">🚚 Tu pedido tiene <strong>envío gratis</strong></p>
    <ul class="cart-items" data-cart-items></ul>
    <p class="cart-empty" data-cart-empty{% if cart.item_count > 0 %} hidden{% endif %}>Tu cesta está vacía.</p>
    <footer class="cart-foot">
      <p class="cart-total"><span>Total</span><strong data-cart-total>{{ cart.total_price | money }}</strong></p>
      <a class="btn btn-fire btn-block cart-checkout" href="{{ routes.root_url }}checkout" data-cart-checkout{% if cart.item_count == 0 %} aria-disabled="true"{% endif %}>Finalizar compra →</a>
      <p class="cart-note">🔒 Pago 100% seguro · {{ settings.return_days }} días para devolverlo</p>
    </footer>
  </aside>

  <script>
    window.__BRAND__ = {
      root: {{ routes.root_url | json }},
      moneyFormat: {{ shop.money_format | json }}
    };
  </script>
  <script src="{{ 'calora.js' | asset_url }}" defer></script>
</body>
</html>
